{
  "name": "hephaestus-frontend",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns \"**/*.smoke.test.ts\"",
    "test:smoke": "bun test smoke",
    "test:changed": "bun test --changed --path-ignore-patterns \"**/*.smoke.test.ts\"",
    "lint": "bun run --parallel --no-exit-on-error \"lint:*\"",
    "lint:es": "eslint .",
    "lint:fmt": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "build:fonts": "python3 scripts/build-mono-font.py"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.1.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.1.1",
    "marked-highlight": "^2.2.4",
    "mermaid": "^12.2.0",
    "nitro": "^3.0.260903-beta",
    "pdfjs-dist": "^6.4.299",
    "solid-js": "^1.9.17",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.4",
    "babel-preset-solid": "^1.9.16",
    "eslint": "^10.13.0",
    "eslint-plugin-solid": "^0.18.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=22"
  }
}
