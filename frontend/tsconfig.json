{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // skipLibCheck: bun-types and vite/client both declare `ImportMeta.hot` and
    // `ImportMeta.env`, and their declarations conflict. This skips checking
    // dependency .d.ts internals only; src/ is still fully type-checked.
    "skipLibCheck": true,
    // "bun" is here only for `bun:test` in *.test.ts. It brings Bun's server
    // globals into scope app-wide, which is harmless: nothing in src/ can call
    // them (this builds to a browser bundle) and the build would fail if it did.
    "types": ["vite/client", "bun"],
    "isolatedModules": true,
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  // Typecheck our app code only — not vite.config.ts / build tooling.
  "include": ["src"]
}
