{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // bun-types and vite/client declare conflicting `ImportMeta.hot`/`env`, and mermaid's
    // types import an uninstalled `type-fest`. src/ is still fully checked.
    "skipLibCheck": true,
    // "bun" is only for `bun:test`. Its server globals are in scope app-wide, but the
    // browser build fails if src/ calls one.
    "types": ["vite/client", "bun"],
    "isolatedModules": true,
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  // App code and the bun test preload; not vite.config.ts / build tooling.
  "include": ["src", "test"]
}
