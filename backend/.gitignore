.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime data — never committed (mirrors the repo-root rule).
data/
*.db
*.db-journal
*.db-wal
.env

# The voice suite's sample projects: their data/ and logs/ are fixture source.
!evals/voice/fixtures/**/data/
!evals/voice/fixtures/**/logs/
!evals/voice/fixtures/**/*.log
