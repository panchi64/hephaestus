class _Event:
    @property
    def data(self) -> str | None: ...
    @property
    def url(self) -> object: ...
    @property
    def etag(self) -> str | None: ...

class Calendar:
    def events(self) -> list[_Event]: ...
    def save_event(self, ical: str) -> _Event: ...

class DAVClient:
    def __init__(
        self,
        url: str | None = None,
        username: str | None = None,
        password: str | None = None,
    ) -> None: ...
    def calendar(self, *, url: str | None = None) -> Calendar: ...
