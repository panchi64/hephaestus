class EmailReplyParser:
    @staticmethod
    def read(text: str) -> EmailMessage: ...
    @staticmethod
    def parse_reply(text: str) -> str: ...

class EmailMessage:
    fragments: list[Fragment]
    text: str
    def __init__(self, text: str) -> None: ...
    def read(self) -> EmailMessage: ...
    @property
    def reply(self) -> str: ...

class Fragment:
    signature: bool
    headers: bool
    hidden: bool
    quoted: bool
    def __init__(self, quoted: bool, first_line: str, headers: bool = False) -> None: ...
    def finish(self) -> None: ...
    @property
    def content(self) -> str: ...
