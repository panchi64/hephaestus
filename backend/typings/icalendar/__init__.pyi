from collections.abc import Callable
from typing import Literal, overload

class Component:
    def add(
        self,
        name: str,
        value: object,
        parameters: dict[str, str] | None = None,
        encode: bool = True,
    ) -> None: ...
    def add_component(self, component: Component) -> None: ...
    def get(self, name: str, default: object = None) -> object: ...
    def walk(
        self, name: str | None = None, select: Callable[[Component], bool] = ...
    ) -> list[Component]: ...
    def to_ical(self) -> bytes: ...
    @overload
    @classmethod
    def from_ical(cls, st: bytes | str, multiple: Literal[False] = False) -> Component: ...
    @overload
    @classmethod
    def from_ical(cls, st: bytes | str, multiple: Literal[True]) -> list[Component]: ...

class Calendar(Component): ...
class Event(Component): ...
